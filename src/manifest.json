{
  "manifest_version": 3,
  "name": "RuihuagDemo",
  "options_page": "options.html",
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-34.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://cn.bing.com/*"],
      "js": ["contentScript.bundle.js"],
      "css": ["bing.styles.css"]
    },
    {
      "matches": ["https://blog.csdn.net/*"],
      "js": ["contentScript.bundle.js"],
      "css": ["csdn.styles.css"]
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["contentScript.bundle.js"],
      "css": ["github.styles.css"]
    },
    {
      "matches": ["https://t.bilibili.com/*"],
      "js": ["contentScript.bundle.js"],
      "css": ["bilibili.styles.css"]
    },
    {
      "matches": ["https://juejin.cn/*"],
      "js": ["contentScript.bundle.js"],
      "css": ["juejin.styles.css"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.bundle.js"],
      "css": ["content.styles.css"]
    }
  ],
  "devtools_page": "devtools.html",
  "web_accessible_resources": [
    {
      "resources": ["content.styles.css", "icon-128.png", "icon-34.png"],
      "matches": []
    }
  ],
  "commands": {
    "toggle-blur": {
      "suggested_key": {
        "default": "Ctrl+Shift+0"
      },
      "description": "Toggle blur effect",
      "global": true
    }
  },
  "permissions": ["bookmarks", "storage", "activeTab", "tabs", "scripting", "nativeMessaging", "commands"]
}
